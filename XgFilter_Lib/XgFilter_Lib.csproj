<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>XgFilter_Lib</RootNamespace>
    <AssemblyName>XgFilter_Lib</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- This library's half of the trim gate (halheinrich/backgammon#129 leg 4):
       the assembly declares itself trim-compatible and runs the trim analyzer
       in its own build, so a reflection-serialization regression becomes a
       build error *here* (TreatWarningsAsErrors) rather than a publish-time
       warning in BgQuiz once that repo's leg flips its suppressions off.
       Per-project deliberately — the test project is not a shipped surface,
       and it serializes through foreign options on purpose. Both are pinned
       by XgFilterJsonContextTests. -->
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BgDataTypes_Lib\BgDataTypes_Lib\BgDataTypes_Lib.csproj" />
    <ProjectReference Include="..\..\ConvertXgToJson_Lib\ConvertXgToJson_Lib\ConvertXgToJson_Lib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XgFilter_Lib.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Enums\" />
    <Folder Include="Projection\" />
  </ItemGroup>

</Project>